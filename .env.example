# Copy to .env. This file intentionally contains no real credentials.
DEBUG=True
SECRET_KEY=development-only-change-before-deploy-8f5d2
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SITE_URL=http://127.0.0.1:8000
# For the Python-only quick start leave DATABASE_URL commented (SQLite dev only).
# Compose sets DATABASE_URL itself using the DB_* values below.
# DATABASE_URL=postgres://cookbook:URL_ENCODED_PASSWORD@db:5432/cookbook
DB_NAME=cookbook
DB_USER=cookbook
DB_PASSWORD=

SALES_ENABLED=False
LEGAL_READY=False
FISCALIZATION_READY=False
LEGAL_VERSION=draft-1
MERCHANT_COUNTRY=
SELLER_DISPLAY_NAME=ИП Новикова Марина Харлампиевна
SELLER_INN=910620715151
SELLER_OGRN=325237500301806
MERCHANT_NAME=[Имя или наименование продавца]
MERCHANT_DETAILS=[Статус, ИНН, адрес и юрисдикция продавца]
CONTACT_EMAIL=valeron684@mail.ru

# YooKassa credentials are entered privately; never commit .env.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST_MODE=True
# Live mode always includes receipts. True also tests receipts in the sandbox.
YOOKASSA_RECEIPTS_ENABLED=False
# Owner confirmed no VAT: 1. 0% VAT is a different code (2).
YOOKASSA_VAT_CODE=1

# All PDFs must be directly inside this private directory, never under static/ or public-media/.
# PRIVATE_ROOT=/app/private
DOWNLOAD_DAYS=30
DOWNLOAD_LIMIT=20

# Set True only behind the supplied trusted Nginx proxy; never trust forwarded headers from the public Internet.
TRUST_PROXY=False

# Telegram: username only, without @ or URL
TELEGRAM_USERNAME=marisha_876

TELEGRAM_SUPPORT_USERNAME=novikov_valerii_s
