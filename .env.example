# Copy to .env. This file intentionally contains no real credentials.
DEBUG=True
SECRET_KEY=development-only-change-before-deploy-8f5d2
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SITE_URL=http://127.0.0.1:8000
# For the Python-only quick start leave DATABASE_URL commented (SQLite dev only).
# Compose sets DATABASE_URL itself using the DB_* values below.
# DATABASE_URL=postgres://cookbook:URL_ENCODED_PASSWORD@db:5432/cookbook
DB_NAME=cookbook
DB_USER=cookbook
DB_PASSWORD=

SALES_ENABLED=False
LEGAL_READY=False
FISCALIZATION_READY=False
LEGAL_VERSION=draft-1
MERCHANT_COUNTRY=
SELLER_DISPLAY_NAME=ИП Новикова Марина Харлампиевна
SELLER_INN=910620715151
SELLER_OGRN=325237500301806
MERCHANT_NAME=[Имя или наименование продавца]
MERCHANT_DETAILS=[Статус, ИНН, адрес и юрисдикция продавца]
CONTACT_EMAIL=marishkinirecepti@mail.ru

# Robokassa is the only adapter for new purchases.
ROBOKASSA_MERCHANT_LOGIN=
# LIVE passwords from the merchant's technical settings:
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
# Separate TEST passwords; there is deliberately no fallback to live passwords.
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=
ROBOKASSA_TEST_MODE=True
# Must match the hash algorithm in the Robokassa cabinet.
ROBOKASSA_HASH_ALGORITHM=SHA256
# The current merchant profile supports RU/RUB only.
ROBOKASSA_CURRENCY=RUB
# Optional documented IncCurrLabel alias; empty lets the provider offer defaults.
ROBOKASSA_PAYMENT_METHOD=

# All PDFs must be directly inside this private directory, never under static/ or public-media/.
# PRIVATE_ROOT=/app/private
DOWNLOAD_DAYS=30
DOWNLOAD_LIMIT=20

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Маришкины рецепты <marishkinirecepti@mail.ru>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Set True only behind the supplied trusted Nginx proxy; never trust forwarded headers from the public Internet.
TRUST_PROXY=False

# Telegram: username only, without @ or URL
TELEGRAM_USERNAME=marisha_876

TELEGRAM_SUPPORT_USERNAME=novikov_valerii_s
